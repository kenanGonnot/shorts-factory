# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel

# --- Visuals ---
PEXELS_API_KEY=

# --- YouTube ---
YOUTUBE_CLIENT_SECRETS_FILE=/app/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/app/secrets/token.json
YOUTUBE_PRIVACY=private

# --- Storage ---
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_DIR=/app/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Infra ---
DATABASE_URL=postgresql+psycopg://shorts:shorts@postgres:5432/shorts
REDIS_URL=redis://redis:6379/0

# --- App ---
LOG_LEVEL=INFO
ENV=dev
